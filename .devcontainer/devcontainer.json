{
	"name": "QuTiJ-Lecture",

	// this repo has a remote — GHCR image names must be lowercase.
	"image": "ghcr.io/ytdhuang/qutij-lecture:latest",

	// Pre-pull so the image is warm even if the container build step races it.
	// Workaround for https://github.com/microsoft/vscode-remote-release/issues/7104
	// Codespaces already has the image ready via prebuilds, so skip this in codespaces, otherwise it re-pull the full image on every codespace creation.
	"initializeCommand": ["bash", "-c", "if [ -z \"$CODESPACES\" ]; then (docker pull ghcr.io/ytdhuang/qutij-lecture:latest && docker image prune --filter 'label=org.opencontainers.image.source=https://github.com/ytdHuang/QuTiJ-Lecture' -f) || true; fi"],

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python", // required for detecting julia-kernel path
				"ms-toolsai.jupyter",
				"julialang.language-julia",
				"chneau.resource-monitor",
				"dracula-theme.theme-dracula"
			],
			"settings": {
				"workbench.colorTheme": "Dracula Theme",
				"editor.unicodeHighlight.ambiguousCharacters": false,
				"python.defaultInterpreterPath": "/opt/conda/bin/python3",
				"julia.symbolCacheDownload": true,
				"julia.enableTelemetry": false,
				"julia.execution.resultType": "inline, errors in REPL",
				"julia.juliaup.install.hint": false,
				"julia.executablePath": "/usr/local/bin/julia",
				"workbench.startupEditor": "readme"
			}
		}
	},

	"postCreateCommand": "cp --update=none /opt/julia/environments/v1.12/Manifest.toml ."

	// Uncomment if running locally with Docker Desktop and hitting permission
	// errors due to a host/container UID mismatch (not needed on Codespaces).
	// "updateRemoteUserUID": true
}
